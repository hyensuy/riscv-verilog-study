; Window Layout <x> <y> <width> <height> <signalwidth> <valuewidth>
viewPort 0 25 1920 514 177 73

; File list:
; openDirFile [-d delimiter] [-s time_offset] [-rf auto_bus_rule_file] path_name file_name
openDirFile -d / "" "/home/user/tmp_IDEC/day2/12.UART/sim/func_sim/wave.fsdb"

; file time scale:
; fileTimeScale ### s|ms|us|ns|ps

; signal spacing:
signalSpacing 5

; windowTimeUnit is used for zoom, cursor & marker
; waveform viewport range
zoom 3214750.000000 67509750.000000
cursor 22490000.000000
marker 22730000.000000

; user define markers
; userMarker time_pos marker_name color linestyle
; visible top row signal index
top 0
; marker line index
markerPos 6

; event list
; addEvent event_name event_expression
; curEvent event_name



COMPLEX_EVENT_BEGIN


COMPLEX_EVENT_END



; toolbar current search type
; curSTATUS search_type
curSTATUS ByChange


addGroup "UART"
activeDirFile "" "/home/user/tmp_IDEC/day2/12.UART/sim/func_sim/wave.fsdb"
addSignal -h 15 /echo_tb/CPU/clk
addSignal -h 15 -holdScope data_addr[31:0]
addSignal -h 15 -holdScope cs_uart_n
addGroup "rx, dataout"
addSignal -h 15 /echo_tb/CPU/iuart_wrap/uart_rx
addSignal -h 15 -holdScope DataOut[31:0]
addGroup "datain, tx"
addSignal -h 15 /echo_tb/CPU/iuart_wrap/DataIn[31:0]
addSignal -h 15 -holdScope uart_tx
addGroup "G4"

; getSignalForm Scope Hierarchy Status
; active file of getSignalForm
activeDirFile "" "/home/user/tmp_IDEC/day2/12.UART/sim/func_sim/wave.fsdb"

GETSIGNALFORM_SCOPE_HIERARCHY_BEGIN
getSignalForm close

"/echo_tb"

SCOPE_LIST_BEGIN
"/echo_tb"
SCOPE_LIST_END

GETSIGNALFORM_SCOPE_HIERARCHY_END


